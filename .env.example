# Copy to .env and fill in. Do NOT commit your real .env (it is gitignored).

# --- Portainer connection ---
PORTAINER_URL=https://portainer.example.com

# Pick exactly one auth strategy: API key OR username+password.
PORTAINER_API_KEY=
# PORTAINER_USERNAME=
# PORTAINER_PASSWORD=

# Set to "false" for self-signed certs.
PORTAINER_VERIFY_SSL=true

# HTTP Basic Auth on the nginx reverse proxy in front of Portainer.
# Leave empty if Portainer is exposed directly. When set, you must also
# provide PORTAINER_USERNAME + PORTAINER_PASSWORD (API key alone won't
# work behind basic auth).
# NGINX_BASIC_AUTH_USER=
# NGINX_BASIC_AUTH_PASSWORD=

# --- Odoo defaults ---
ODOO_CONF_PATH=/etc/odoo/odoo.conf
ODOO_HTTP_PORT=9999
ODOO_DEFAULT_MODULES=dp_base

# --- psql / DB container conventions ---
# DB container name is "{app_name}{DB_CONTAINER_SUFFIX}".
DB_CONTAINER_SUFFIX=_db
# psql user and database. {name} = app container name (without suffix).
PSQL_USER_TEMPLATE={name}
PSQL_DB_TEMPLATE={name}

# --- Runner tuning ---
# Seconds to wait after start/restart for "running" state.
WAIT_RUNNING_TIMEOUT=120
# Default max concurrent containers per environment.
# CLI flag --per-env-workers wins when set.
PER_ENV_WORKERS_DEFAULT=10
